# Normalize all detected text files to LF.
* text=auto eol=lf

# Unix and Maven wrapper scripts must remain executable-compatible.
*.sh text eol=lf
mvnw text eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

# Never apply text conversions to binary files.
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.zip binary
*.gz binary
